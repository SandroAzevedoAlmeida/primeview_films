---
import { social } from '../config/social';

const links = [
  ['Instagram', social.instagram, '@primeview_filmes'],
  ['YouTube', social.youtube, '@primeview_filmesbr'],
  ['Facebook', social.facebook, 'Perfil oficial'],
  ['TikTok', social.tiktok, '@primeview.filmes'],
  ['WhatsApp', social.whatsapp, 'Fale conosco'],
  ['Threads', social.threads, '@primeview_filmes'],
];
---

<div class="social-links">
  {links.map(([name, href, detail]) => <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${name}: ${detail}`}><span class={`social-icon social-icon-${name.toLowerCase()}`} aria-hidden="true">
    {name === 'Instagram' && <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" class="icon-fill"></circle></svg>}
    {name === 'YouTube' && <svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4"></rect><path d="m10 9 5 3-5 3z" class="icon-fill"></path></svg>}
    {name === 'Facebook' && <svg viewBox="0 0 24 24"><path d="M14 21v-8h2.8l.4-3H14V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.5-.1C12.3 3.9 10 5.5 10 8.3V10H7.5v3H10v8z" class="icon-fill"></path></svg>}
    {name === 'TikTok' && <svg viewBox="0 0 24 24"><path d="M14.5 4v10.2a3.5 3.5 0 1 1-3-3.5v3a.8.8 0 1 0 .7.8V4h2.3c.3 1.5 1.2 2.5 2.8 2.8v2.3A6 6 0 0 1 14.5 8z" class="icon-fill"></path></svg>}
    {name === 'WhatsApp' && <svg viewBox="0 0 24 24"><path d="M12 3a8.5 8.5 0 0 0-7.3 12.8L3 21l5.3-1.7A8.5 8.5 0 1 0 12 3zm0 15.2a6.6 6.6 0 0 1-3.4-.9l-.3-.2-2.7.9.9-2.6-.2-.3A6.6 6.6 0 1 1 12 18.2zm3.7-4.9c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.6.1l-.4.6c-.1.2-.3.2-.5.1a5.4 5.4 0 0 1-2.7-2.4c-.2-.3 0-.4.1-.6l.4-.5c.1-.2.1-.3 0-.5l-.6-1.4c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.8-.9 2s.9 2.3 1 2.4c.1.2 1.8 2.8 4.4 3.9 2.2.9 2.2.6 2.6.6.4 0 1.3-.5 1.5-1 .2-.5.2-.9.1-1s-.3-.2-.6-.3z" class="icon-fill"></path></svg>}
    {name === 'Threads' && <svg viewBox="0 0 24 24"><path d="M12 3.5c-4.6 0-7.5 2.7-7.5 7.1h2.2c0-3 1.7-4.8 5.3-4.8 3.1 0 5.1 1.5 5.5 4.3a8 8 0 0 0-3.4-.7c-3.5 0-5.8 1.8-5.8 4.6 0 2.7 2.2 4.5 5.2 4.5 3.9 0 6.3-2.5 6.3-6.8C19.8 6.5 16.9 3.5 12 3.5zm1.5 12.7c-1.7 0-2.9-.8-2.9-2.1 0-1.5 1.4-2.4 3.5-2.4 1.1 0 2.1.2 2.9.6-.1 2.5-1.3 3.9-3.5 3.9z" class="icon-fill"></path></svg>}
  </span><span>{name}</span><small>{detail}</small><b aria-hidden="true">↗</b></a>)}
</div>