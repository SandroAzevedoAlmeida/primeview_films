---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="contact-form" action="/api/contact" method="POST" data-contact-form>
  <div class="form-grid">
    <label>Nome<input name="name" type="text" autocomplete="name" required maxlength="100" placeholder="Como podemos chamar você?" /></label>
    <label>E-mail<input name="email" type="email" autocomplete="email" required maxlength="160" placeholder="seu@email.com" /></label>
    <label>WhatsApp<input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="(00) 00000-0000" /></label>
    <label>Perfil do cliente<select name="profile" required><option value="">Selecione</option><option>Corretor</option><option>Imobiliária</option><option>Construtora</option><option>Incorporadora</option><option>Proprietário</option><option>Outro</option></select></label>
    <label class="full-width">Serviço de interesse<select name="service" required><option value="">Selecione</option><option>Vídeo imobiliário</option><option>Drone 4K</option><option>Fotografia imobiliária</option><option>Tour Virtual 360°</option><option>Conteúdo para corretor</option><option>Pacote completo</option><option>Outro</option></select></label>
    <label class="full-width">Mensagem<textarea name="message" required maxlength="2000" rows="5" placeholder="Conte um pouco sobre o imóvel ou projeto."></textarea></label>
    <input class="honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
  </div>
  <div class="form-actions"><button class="button button-gold" type="submit" data-submit>Enviar solicitação <span aria-hidden="true">↗</span></button><p class="form-status" role="status" data-form-status></p></div>
</form>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submit || !status) return;
    submit.disabled = true; submit.textContent = 'Enviando...'; status.textContent = '';
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('request');
      form.reset(); status.textContent = 'Mensagem enviada com sucesso. A PrimeView Filmes recebeu sua solicitação e entrará em contato.'; status.dataset.state = 'success';
    } catch { status.textContent = 'Não foi possível enviar sua mensagem agora. Tente novamente ou fale conosco pelo WhatsApp.'; status.dataset.state = 'error'; }
    submit.disabled = false; submit.innerHTML = 'Enviar solicitação <span aria-hidden="true">↗</span>';
  });
</script>